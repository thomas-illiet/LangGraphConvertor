{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "langflow-converter": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--frozen",
        "langflow-converter-mcp",
        "--workspace",
        ".",
        "--transport",
        "stdio"
      ],
      "enabled": true
    },
    "langflow-converter-http": {
      "type": "remote",
      "url": "http://127.0.0.1:8765/mcp",
      "enabled": false
    }
  }
}
