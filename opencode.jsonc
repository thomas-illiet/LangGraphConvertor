{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen 3.8 27B (local)",
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "langflow-converter": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--frozen",
        "langflow-converter-mcp",
        "--workspace",
        ".",
        "--transport",
        "stdio"
      ],
      "cwd": ".",
      "enabled": true
    },
    "langflow-converter-http": {
      "type": "remote",
      "url": "http://127.0.0.1:8765/mcp",
      "enabled": false
    }
  }
}
